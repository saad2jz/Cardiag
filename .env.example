# Fournisseur conseillé avec une clé Google AI Studio.
LLM_PROVIDER=gemini

# Clé secrète : ne jamais la placer dans le frontend ni la commiter.
GEMINI_API_KEY=remplacez-moi

# Modèles verrouillés côté serveur : Flash-Lite par défaut, Flash 3.6 pour les cas sensibles.

# Alternative OpenAI : passez LLM_PROVIDER à openai et renseignez ces valeurs.
# OPENAI_API_KEY=sk-proj-remplacez-moi
# OPENAI_MODEL=gpt-4o

PORT=3000

# Origines supplémentaires séparées par des virgules.
FRONTEND_ORIGINS=https://votre-compte.github.io
