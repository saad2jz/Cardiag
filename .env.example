# Fournisseur conseillé avec une clé Google AI Studio.
LLM_PROVIDER=gemini

# Clé secrète : ne jamais la placer dans le frontend ni la commiter.
GEMINI_API_KEY=remplacez-moi

# Modèles verrouillés côté serveur : Flash-Lite par défaut, Flash 3.6 pour les cas sensibles.

# Alternative OpenAI : passez LLM_PROVIDER à openai et renseignez ces valeurs.
# OPENAI_API_KEY=sk-proj-remplacez-moi
# OPENAI_MODEL=gpt-4o

PORT=3000

# Origines supplémentaires séparées par des virgules.
FRONTEND_ORIGINS=https://votre-compte.github.io

# URL publique utilisée pour les liens de partage de rapports.
PUBLIC_ORIGIN=https://cardiag.online

# Firebase Admin (serveur uniquement). Utilisez les identifiants d'un compte
# de service Firebase et conservez la clé privée exclusivement dans les
# variables secrètes de Render.
FIREBASE_PROJECT_ID=cardiag-f1ea7
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cardiag-f1ea7.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nremplacez-moi\n-----END PRIVATE KEY-----\n"
